@page "/products"
@rendermode InteractiveWebAssembly

@using Blazzor.Client.Modelos
@using Blazzor.Client.Servicios

@inject ProductoService ProductoService
@inject NavigationManager Navigation

<h3>Productos</h3>

@if (products is null)
{
    <p>Cargando...</p>
}
else
{
    <button class="btn btn-primary mb-3" @onclick="CrearProducto"> Nuevo </button>
    <table class="table">
        <thead>
            <tr>
                <th>Descripcion</th>
                <th>Codigo</th>
                <th>Categoria</th>
                <th>Stock</th>
                <th>Precio</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var producto in products)
            {
                <tr class="@(producto.CantidadStock < 10 ? "table-danger" : "")"
                    @onclick="() => OpenDetail(producto.Id)"
                    style="cursor:pointer">

                    <td>@producto.Descripcion</td>
                    <td>@producto.Codigo</td>
                    <td>@producto.Categoria</td>
                    <td>@producto.CantidadStock</td>
                    <td>$@producto.PrecioUnitario.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {

    private List<ProductoDTO>? products;

    protected override async Task OnInitializedAsync()
    {
        products = await ProductoService.GetProductsAsync();
    }

    private void OpenDetail(int id)
    {
        Navigation.NavigateTo($"/products/{id}");
    }
    private void CrearProducto()
    {
    Navigation.NavigateTo("/products/crear");
    }
}